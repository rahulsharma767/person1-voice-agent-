# LiveKit Cloud project credentials (cloud.livekit.io -> your project -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Google AI Studio free-tier key (https://aistudio.google.com/apikey)
# Used for Gemini Live API in TEXT modality (STT + LLM combined, no separate STT provider).
GOOGLE_API_KEY=your_google_ai_studio_key

# Rime (https://rime.ai -> API Tokens)
RIME_API_KEY=your_rime_api_key

# --- DHWANI-specific (used once Person 2's guard client is wired in) ---
# Leave unset while using the local mock guard.
DHWANI_GUARD_MODE=mock
